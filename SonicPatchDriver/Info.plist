<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Info.plist for the SonicPatch AudioServerPlugIn (.driver bundle).

    Installed under /Library/Audio/Plug-Ins/HAL/SonicPatch.driver. coreaudiod
    discovers the bundle, reads CFPlugInFactories to find the factory UUID ->
    function mapping, and calls SonicPatchPlugInFactory (see PlugInMain.cpp).

    The CFPlugInFactories UUID below is a PLACEHOLDER. Generate a real, unique
    UUID with `uuidgen` before shipping and keep it stable across releases.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>SonicPatchDriver</string>
    <key>CFBundleIdentifier</key>
    <string>com.sonicpatch.driver</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>SonicPatch</string>
    <key>CFBundlePackageType</key>
    <string>BNDL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- HAL plug-in factory registration. The outer key is the factory UUID;
         its value is the C factory function exported from the binary. -->
    <key>CFPlugInFactories</key>
    <dict>
        <key>11111111-2222-3333-4444-555555555555</key>
        <string>SonicPatchPlugInFactory</string>
    </dict>

    <!-- Maps the AudioServerPlugIn type UUID to our factory UUID. The type UUID
         (kAudioServerPlugInTypeUUID) is fixed by Core Audio. -->
    <key>CFPlugInTypes</key>
    <dict>
        <key>443ABAB8-E7B3-491A-B985-BEB9187030DB</key>
        <array>
            <string>11111111-2222-3333-4444-555555555555</string>
        </array>
    </dict>
</dict>
</plist>
